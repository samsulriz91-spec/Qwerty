+.entry-actions > :last-child { flex: 1; }
+.capture-action { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: 9px; width: 100%; min-height: 56px; padding: 7px 3px; border-bottom: 1px solid var(--line); color: var(--accent); text-align: left; }
+.capture-action strong, .capture-action small { display: block; }
+.capture-action small { margin-top: 3px; color: var(--muted); }
+.capture-action .icon:last-child { width: 17px; transform: rotate(-90deg); }
+.entry-status, .layer-switch { display: grid; grid-auto-columns: minmax(0,1fr); grid-auto-flow: column; gap: 5px; margin: 9px 0; }
+.entry-status button, .layer-switch button { display: grid; gap: 3px; min-height: 44px; padding: 6px 4px; border: 1px solid var(--line); border-radius: 8px; background: var(--field); text-align: left; }
+.entry-status strong, .layer-switch b { color: var(--ink); font-size: 12px; }
+.entry-status small, .layer-switch small { color: var(--muted); font-size: 10px; overflow-wrap: anywhere; }
+.entry-status button[aria-pressed="true"], .layer-switch button[aria-pressed="true"] { border-color: #8873b3; background: var(--accent-wash); }
+.layer-count-actions { display: flex; justify-content: space-between; gap: 6px; }
+.layer-count-actions .textbtn { padding: 0 4px; }
+.entry-ocr-note { margin: 6px 0; color: var(--accent); font-size: 12px; line-height: 1.4; }
+.entry-guidance { margin: 6px 0 10px; color: var(--muted); font-size: 12px; line-height: 1.45; }
+.entry-risk-field { margin: 12px 0; padding-inline-start: 10px; border-inline-start: 2px solid var(--accent); }
+.entry-risk-field .field { margin-bottom: 0; }
+.entry-risk-summary { display: flex; flex-wrap: wrap; gap: 5px 14px; font-size: 12px; color: var(--muted); }
+.entry-risk-summary b { margin-inline-start: 3px; color: var(--ink); font-variant-numeric: tabular-nums; }
+.risk-coverage { margin: 7px 0; padding-inline-start: 10px; border-inline-start: 2px solid var(--accent); }
+.entry-review-row { display: grid; grid-template-columns: 26px minmax(0,1fr) minmax(0,auto); gap: 6px; padding: 9px 0; border-top: 1px solid var(--line); overflow-wrap: anywhere; font-size: 12px; }
+.entry-review-row:first-of-type { margin-top: 8px; }
+.entry-review-row small { display: block; color: var(--muted); font-size: 10px; margin-top: 4px; }
+.entry-review-row .entry-review-times { grid-column: 2 / -1; margin: 0; }
+.ocr-upload { display: grid; gap: 7px; padding: 9px; background: var(--accent-wash); border: 1px solid #8873b3; border-radius: 9px; color: var(--accent); font-size: 13px; }
+.ocr-upload input { width: 100%; color: var(--muted); }
+.ocr-options, .entry-account-bar { padding-top: max(10px,env(safe-area-inset-top,0px)); }
+.entry-title-controls { display: flex; align-items: center; gap: 4px; }
+.entry-title-controls .icon { width: 17px; }
+.entry-actions {
+  position: sticky;
+  bottom: calc(75px + env(safe-area-inset-bottom,0px));
+  z-index: 1;
+  padding: 7px;
+  border: 1px solid var(--line);
+  border-radius: 11px;
+  background: var(--bg);
+}
+
+.entry-mode { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); }
+.entry-mode button { display: grid; align-content: center; gap: 3px; min-height: 50px; padding: 5px 6px; border-bottom: 2px solid transparent; text-align: left; }
+.entry-mode button[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); }
+.entry-mode strong { font-size: 13px; }
+.entry-mode small { font-size: 11px; color: var(--muted); }
+.quick-workspace .draft-status { margin-top: 8px; }
+.quick-extra { border-top: 1px solid var(--line); }
+#ocr-preview[hidden] { display: none; }
+.ocr-action-bar { position: sticky; bottom: 0; z-index: 1; padding: 6px 0; background: var(--surface); }
+
+/* The import preview is a statement, with one line of emphasis per layer. */
+.ocr-import > #ocr-progress { margin: 10px 0; font-size: 13px; }
+.ocr-zone { padding-bottom: 9px; border-bottom: 1px solid var(--line); }
+.ocr-zone .field { margin: 0 0 4px; }
+.ocr-zone small, .ocr-batch-head span { color: var(--muted); font-size: 12px; }
+.ocr-batch-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 9px; justify-content: space-between; padding: 13px 0 5px; }
+.ocr-batch-head > strong { font-size: 14px; }
+.ocr-layer { border-bottom: 1px solid var(--line); padding: 9px 0 2px; }
+.ocr-layer-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; flex-wrap: wrap; }
+.ocr-layer-index { color: var(--accent); font-size: 12px; font-weight: 700; margin-right: 4px; }
+.ocr-layer-heading strong { font-size: 13px; }
+.ocr-layer-pl { font-variant-numeric: tabular-nums; }
+.ocr-quotes { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 5px; margin: 7px 0 0; }
+.ocr-quotes dt { color: var(--muted); font-size: 10px; }
+.ocr-quotes dd { margin: 2px 0 0; font-size: 12px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+.ocr-layer .ocr-layer-time { font-size: 11px; margin: 5px 0 0; }
+.ocr-edit summary { color: var(--accent); }
+.ocr-import .ocr-options { border-top: 1px solid var(--line); }
+.layer-workbench { padding: 12px 0 0; border-top: 1px solid var(--line); margin: 13px 0; }
+.layer-workbench .layer-switch { gap: 0; border-bottom: 1px solid var(--line); }
+.layer-workbench .layer-switch button { border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: none; min-height: 48px; padding-inline: 7px; }
+.layer-workbench .layer-switch button[aria-pressed="true"] { border-bottom-color: var(--accent); background: none; }
+.layer-workbench .layer-switch button[aria-pressed="true"] b { color: var(--accent); }
+.layer-workbench .entry-ocr-note { border-bottom: 1px solid var(--line); padding: 0 0 8px; }
+.ocr-layer-heading small { color: var(--muted); font-size: 11px; }
