+/* Calm Cockpit, shared visual language for the Core RC interface. */
+:root {
+  --bg: #141318;
+  --surface: #1d1b23;
+  --raised: #26232f;
+  --field: #18171e;
+  --line: #373342;
+  --control-line: #716a82;
+  --ink: #f3effa;
+  --muted: #b7afc7;
+  --accent: #c7b9ff;
+  --accent-ink: #211737;
+  --accent-wash: #342a49;
+  --green: #84dfbc;
+  --red: #ffacb6;
+  --pad: clamp(16px, 5vw, 24px);
+  --nav-space: calc(96px + env(safe-area-inset-bottom, 0px));
+  --demo-width: 480px;
+}
+
+body {
+  background: #100f14;
+  scroll-padding-bottom: var(--nav-space);
+}
+
+html { scroll-padding-bottom: var(--nav-space); }
+html:has(#dialog[open]) { overflow: hidden; }
+.app { min-height: 100dvh; }
+.icon { vertical-align: middle; }
+button:focus-visible, input:focus-visible, select:focus-visible,
+textarea:focus-visible, summary:focus-visible, [tabindex]:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.top {
+  padding: max(12px, env(safe-area-inset-top, 0px)) var(--pad) 10px;
+  min-height: 68px;
+  gap: 10px;
+}
+.brand, .brand-mark { display: flex; align-items: center; }
+.brand { gap: 10px; min-width: 0; }
+.brand-mark {
+  justify-content: center;
+  width: 36px;
+  height: 36px;
+  flex: 0 0 36px;
+  border-radius: 11px;
+  background: var(--accent-wash);
+  color: var(--accent);
+}
+.brand-mark .icon { width: 20px; height: 20px; }
+.brand-name { display: block; font-size: 15px; font-weight: 650; letter-spacing: -.35px; }
+.buildtag {
+  display: block;
+  padding: 0;
+  background: transparent;
+  color: var(--muted);
+  font-size: 10px;
+  line-height: 1.55;
+}
+.top .round { flex-shrink: 0; background: var(--surface); border: 1px solid var(--line); }
+.context {
+  padding: 5px var(--pad) 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 8px;
+}
+.account, .mode {
+  min-width: 0;
